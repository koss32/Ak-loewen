# Server-only values. Keep real values in Vercel Environment Variables or a gitignored local file.
TELEGRAM_BOT_TOKEN=
# Form and staff routing require a negative Telegram group/supergroup ID (for example -100...).
TELEGRAM_CHAT_ID_AK=
# Exact HTTPS site origin, without a path/query/credentials. A single trailing slash is normalized.
PUBLIC_ORIGIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Compatibility alternative only: supply this complete URL/token pair, never one KV value mixed with one UPSTASH value.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Website form delivery is OFF by default. Enabling it additionally requires a
# published legal source, FORM_PUBLICATION_STATUS=published, and the exact
# approved legal consent version in FORM_CONSENT_VERSION.
FORM_DELIVERY_ENABLED=false
# Build + HTTP indexing switch. OFF unless an explicitly authorized Vercel production launch.
# Preview, local, custom environments and noncanonical deployment hosts stay noindex.
INDEXING_ENABLED=false
FORM_PUBLICATION_STATUS=pending
FORM_CONSENT_VERSION=
# Local development has a second explicit opt-in. Leave false; credentials
# inherited from a shell must never enable local Telegram delivery by themselves.
LOCAL_FORM_DELIVERY_ENABLED=false

# Telegram-native bot. All switches stay false until privacy publication and a
# manual staging/deployment review are complete. Secrets must be random >=32 chars.
BOT_ENABLED=false
BOT_WEBHOOK_ENABLED=false
# Preview ops are pinned to release-6 and a VERCEL_URL / VERCEL_BRANCH_URL host.
# Exact HTTPS origin, configured only after the target deployment is verified.
TELEGRAM_OPS_PREVIEW_ORIGIN=
# Separate authorization required before any ops mutation; leave OFF.
TELEGRAM_OPS_MUTATIONS_ENABLED=false
# DISABLED / FUTURE CAPABILITY: no scheduler required for booking or contact.
BOT_WORKER_ENABLED=false
BOT_REMINDERS_ENABLED=false
TELEGRAM_BOT_USERNAME=
# allowlist requires TELEGRAM_STAFF_USER_IDS; group_members uses fresh Telegram membership checks.
TELEGRAM_STAFF_AUTH_MODE=allowlist
TELEGRAM_STAFF_USER_IDS=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WORKER_SECRET=
TELEGRAM_SEND_TIMEOUT_MS=8000
BOT_REDIS_PREFIX={akbot}:
PRIVACY_URL=
PRIVACY_PUBLICATION_STATUS=pending
PRIVACY_CONSENT_VERSION=telegram-2026-09-15-v1
# Reserved for a future ownership-proofed web-to-Telegram bridge; leave disabled.
WEB_TELEGRAM_BRIDGE_ENABLED=false
WEB_TELEGRAM_BRIDGE_SECRET=
