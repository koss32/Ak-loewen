# Server-only values. Keep real values in Vercel Environment Variables or a gitignored local file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_AK=
PUBLIC_ORIGIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FORM_DELIVERY_ENABLED=false

# Telegram-native bot. All switches stay false until privacy publication and a
# manual staging/deployment review are complete. Secrets must be random >=32 chars.
BOT_ENABLED=false
BOT_WEBHOOK_ENABLED=false
# DISABLED / FUTURE CAPABILITY: no scheduler required for booking or contact.
BOT_WORKER_ENABLED=false
BOT_REMINDERS_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_STAFF_USER_IDS=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WORKER_SECRET=
TELEGRAM_SEND_TIMEOUT_MS=8000
BOT_REDIS_PREFIX={akbot}:
PRIVACY_URL=
PRIVACY_PUBLICATION_STATUS=pending
PRIVACY_CONSENT_VERSION=telegram-2026-09-15-v1
# Reserved for a future ownership-proofed web-to-Telegram bridge; leave disabled.
WEB_TELEGRAM_BRIDGE_ENABLED=false
WEB_TELEGRAM_BRIDGE_SECRET=
